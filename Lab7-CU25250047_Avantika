#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int main() {
    vector<int> a = {2, 1, 5, 2, 3, 2};
    int target = 7;

    int left = 0;
    long long sum = 0;
    int ans = INT_MAX;

    for (int right = 0; right < a.size(); right++) {
        sum += a[right];

        while (sum > target) {
            ans = min(ans, right - left + 1);
            sum -= a[left++];
        }
    }

    if (ans == INT_MAX)
        cout << -1;
    else
        cout << "Smallest Length = " << ans;

    return 0;
}
