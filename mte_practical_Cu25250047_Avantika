#include <iostream>
#include <string>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        string s;
        cin >> s;

        int freq[26] = {0};

        for (char c : s)
            freq[c - 'a']++;

        int ans = 0;

        for (int i = 0; i < 26; i++)
            ans += freq[i] / 2;

        cout << ans << endl;
    }

    return 0;
}
