#include <iostream>
using namespace std;
int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        int A[1000];

        for (int i = 0; i < N; i++)
            cin >> A[i];

        bool same = true;

        for (int i = 1; i < N; i++) {
            if (A[i] != A[0]) {
                same = false;
                break;
            }
        }

        if (same)
            cout << -A[0] << endl;
        else
            cout << -1 << endl;
    }
    return 0;
}


