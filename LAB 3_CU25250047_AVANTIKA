#include <iostream>
using namespace std;

// Node for linked list
struct Node {
    int data;
    Node* next;
};

// Stack
Node* top = NULL;

void push(int value) {
    Node* newNode = new Node();
    newNode->data = value;
    newNode->next = top;
    top = newNode;

    cout << value << " pushed into stack\n";
}

void pop() {
    if (top == NULL) {
        cout << "Stack is empty\n";
        return;
    }

    Node* temp = top;
    cout << top->data << " popped from stack\n";
    top = top->next;
    delete temp;
}

// Queue
Node* front = NULL;
Node* rear = NULL;

void enqueue(int value) {
    Node* newNode = new Node();
    newNode->data = value;
    newNode->next = NULL;

    if (rear == NULL) {
        front = rear = newNode;
    } else {
        rear->next = newNode;
        rear = newNode;
    }

    cout << value << " enqueued into queue\n";
}

void dequeue() {
    if (front == NULL) {
        cout << "Queue is empty\n";
        return;
    }

    Node* temp = front;
    cout << front->data << " dequeued from queue\n";
    front = front->next;

    if (front == NULL)
        rear = NULL;

    delete temp;
}

int main() {

    // Stack operations
    cout << "STACK OPERATIONS\n";

    push(10);
    push(20);
    push(30);

    pop();
    pop();

    // Queue operations
    cout << "\nQUEUE OPERATIONS\n";

    enqueue(10);
    enqueue(20);
    enqueue(30);

    dequeue();
    dequeue();

    return 0;
}
