#include <iostream>
#include <vector>
#include <map>
using namespace std;

int digitSum(int n) {
    n = abs(n);
    int sum = 0;

    while (n > 0) {
        sum += n % 10;
        n /= 10;
    }

    return sum;
}

void solve() {
    int N;
    cin >> N;

    vector<int> nums(N);

    for (int i = 0; i < N; i++) {
        cin >> nums[i];
    }

    map<int, long long> freq;
    long long count = 0;

    for (int i = 0; i < N; i++) {
        int sum = digitSum(nums[i]);

        count += freq[sum];
        freq[sum]++;
    }

    cout << count << endl;
}

int main() {
    solve();
    return 0;
}
