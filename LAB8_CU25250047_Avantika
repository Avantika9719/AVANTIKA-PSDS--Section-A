#include <iostream>
#include <vector>
using namespace std;

int main() {
    int N, K;

    cin >> N >> K;

    vector<int> arr(N);

    for (int i = 0; i < N; i++) {
        cin >> arr[i];
    }

    int windowSum = 0;

    for (int i = 0; i < K; i++) {
        windowSum += arr[i];
    }

    int maxSum = windowSum;

    for (int i = K; i < N; i++) {
        windowSum = windowSum - arr[i - K] + arr[i];

        if (windowSum > maxSum) {
            maxSum = windowSum;
        }
    }

    cout << "Maximum sum = " << maxSum;

    return 0;
}
















